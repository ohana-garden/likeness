# Application Settings
DEBUG=false
LOG_LEVEL=INFO

# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here  # Optional
HUME_API_KEY=your_hume_api_key_here  # Optional, for voice
TWILIO_ACCOUNT_SID=your_twilio_sid  # Optional, for SMS
TWILIO_AUTH_TOKEN=your_twilio_token  # Optional, for SMS
TWILIO_PHONE_NUMBER=+1234567890  # Optional, for SMS
MAPBOX_API_KEY=your_mapbox_key  # Optional, for routing

# Database (Docker defaults)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=volunteer_hub
POSTGRES_USER=hub
POSTGRES_PASSWORD=password

# Redis (Docker defaults)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Feature Flags
ENABLE_VOICE=true
ENABLE_SMS_FALLBACK=true
ENABLE_DIGITAL_TWINS=true
ENABLE_MULTI_AGENT=true
